# Brota Digital — variables de entorno
#
# Copiar a .env.local y cargar los valores ahí (y en Vercel, en Production
# Y EN Preview). .env.local está gitignored; este archivo NO lleva valores.
#
# El endpoint del formulario es fail-closed: si falta cualquiera de estas
# variables, responde 503 en vez de procesar sin protecciones.

# Envío del formulario de contacto — resend.com (requiere dominio verificado)
RESEND_API_KEY=
# A dónde llegan las solicitudes.
CONTACT_EMAIL=
# Remitente. Tiene que estar en el dominio verificado en Resend, o el envío se
# rechaza. Admite «Nombre <buzon@dominio>». El correo del visitante NO va aquí:
# va en `reply_to`, porque ponerlo de remitente rompe SPF y manda todo a spam.
CONTACT_FROM=

# Rate limiting por IP — upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anti-bot — Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# URL canónica del sitio (sin barra final). Ej: https://brotadigital.mx
NEXT_PUBLIC_SITE_URL=
